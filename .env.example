# Google Places API (New) kulcs – Google Cloud Console > APIs & Services > Credentials
# Engedélyezni kell: "Places API (New)". A kulcsot érdemes IP-címre korlátozni.
GOOGLE_PLACES_API_KEY=

# Opcionális: ha üres, a szerver első induláskor név + cím alapján megkeresi és kiírja a konzolra.
GOOGLE_PLACE_ID=

# Opcionális beállítások
REVIEWS_CACHE_HOURS=6
REVIEWS_MIN_RATING=4
PORT=8787
